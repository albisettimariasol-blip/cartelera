<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ISFD 19 - Cartelera de Redes</title>
    
    <!-- Librerías Externas -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #020617; color: #f8fafc; }
        .card-redes { background: #0f172a; border: 1px solid #1e293b; transition: all 0.3s ease; }
        .card-redes:hover { border-color: #3b82f6; transform: translateY(-2px); }
        .loading-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        // --- CONFIGURACIÓN DE GOOGLE SHEETS ---
        // 1. Ve a tu Sheet -> Archivo -> Compartir -> Publicar en la Web.
        // 2. Selecciona "Valores separados por comas (.csv)" y copia el link aquí abajo.
        const GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/TU_ID_AQUI/pub?output=csv";

        function App() {
            const [rows, setRows] = useState([]);
            const [loading, setLoading] = useState(true);
            const [lastUpdate, setLastUpdate] = useState(null);
            const [filtroDia, setFiltroDia] = useState("");

            useEffect(() => {
                // Determinar día actual automáticamente
                const dias = ["Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"];
                const hoy = dias[new Date().getDay()];
                setFiltroDia(hoy === "Domingo" ? "Lunes" : hoy);
                
                fetchData();
                
                // Opcional: Auto-actualizar cada 5 minutos mientras la pestaña esté abierta
                const interval = setInterval(fetchData, 300000);
                return () => clearInterval(interval);
            }, []);

            const fetchData = () => {
                setLoading(true);
                // Añadimos un "Cache Buster" (timestamp) para forzar a Google a darnos la versión más nueva
                const urlNoCache = `${GOOGLE_SHEET_CSV_URL}&t=${new Date().getTime()}`;

                Papa.parse(urlNoCache, {
                    download: true,
                    header: true,
                    skipEmptyLines: true,
                    complete: (results) => {
                        console.log("Datos sincronizados:", results.data);
                        setRows(results.data);
                        setLastUpdate(new Date().toLocaleTimeString());
                        setLoading(false);
                    },
                    error: (err) => {
                        console.error("Error de sincronización:", err);
                        setLoading(false);
                    }
                });
            };

            const filteredData = useMemo(() => {
                return rows.filter(r => {
                    const diaRow = (r.Día || r.dia || "").trim().toLowerCase();
                    return diaRow === filtroDia.toLowerCase();
                });
            }, [rows, filtroDia]);

            return (
                <div className="min-h-screen p-4 md:p-8 max-w-4xl mx-auto">
                    {/* Header */}
                    <header className="flex justify-between items-center mb-8 border-b border-slate-800 pb-6">
                        <div>
                            <h1 className="text-3xl font-black text-white tracking-tight">CARTELERA <span className="text-blue-500">REDES</span></h1>
                            <p className="text-slate-500 text-sm mt-1 font-medium">
                                {loading ? "Sincronizando con Google Sheets..." : `Actualizado: ${lastUpdate}`}
                            </p>
                        </div>
                        <button 
                            onClick={fetchData}
                            className="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-full transition-colors"
                            title="Refrescar ahora"
                        >
                            <i className={`fa-solid fa-arrows-rotate ${loading ? 'animate-spin' : ''}`}></i>
                        </button>
                    </header>

                    {/* Selector de Días */}
                    <div className="flex gap-2 overflow-x-auto pb-4 no-scrollbar mb-6">
                        {["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"].map(d => (
                            <button
                                key={d}
                                onClick={() => setFiltroDia(d)}
                                className={`px-5 py-2 rounded-xl text-sm font-bold transition-all shrink-0 ${
                                    filtroDia === d 
                                    ? 'bg-blue-500 text-white shadow-lg shadow-blue-500/20' 
                                    : 'bg-slate-900 text-slate-400 border border-slate-800'
                                }`}
                            >
                                {d}
                            </button>
                        ))}
                    </div>

                    {/* Lista de Aulas */}
                    <div className="grid gap-4">
                        {loading && rows.length === 0 ? (
                            <div className="text-center py-20">
                                <div className="loading-pulse text-blue-500 text-4xl mb-4">
                                    <i className="fa-solid fa-cloud-arrow-down"></i>
                                </div>
                                <p className="text-slate-500 font-bold uppercase tracking-widest text-xs">Obteniendo datos de la red...</p>
                            </div>
                        ) : filteredData.length > 0 ? (
                            filteredData.map((item, i) => (
                                <div key={i} className="card-redes p-5 rounded-2xl flex justify-between items-center">
                                    <div>
                                        <div className="flex items-center gap-2 mb-1">
                                            <span className="text-[10px] font-black text-blue-400 uppercase tracking-tighter">
                                                {item.Carrera || item.carrera || "Redes e Informática"}
                                            </span>
                                        </div>
                                        <h3 className="text-lg font-bold text-white uppercase leading-tight">
                                            {item.Materia || item.materia}
                                        </h3>
                                        <p className="text-slate-500 text-sm font-medium mt-1">
                                            <i className="fa-regular fa-clock mr-1"></i> {item.Horario || item.horario}
                                        </p>
                                    </div>
                                    <div className="bg-blue-600/10 border border-blue-500/20 w-16 h-16 rounded-2xl flex flex-col items-center justify-center shrink-0">
                                        <span className="text-[9px] font-black text-blue-500 uppercase">Aula</span>
                                        <span className="text-2xl font-black text-white">{item.Aula || item.aula}</span>
                                    </div>
                                </div>
                            ))
                        ) : (
                            <div className="bg-slate-900/50 border-2 border-dashed border-slate-800 rounded-3xl py-16 text-center">
                                <i className="fa-solid fa-calendar-xmark text-slate-700 text-3xl mb-3"></i>
                                <p className="text-slate-600 font-bold text-sm uppercase">No hay clases programadas para este día</p>
                            </div>
                        )}
                    </div>

                    <footer className="mt-12 text-center">
                        <p className="text-slate-700 text-[10px] font-bold uppercase tracking-widest">
                            Sincronización Directa via ISFD 19 Cloud
                        </p>
                    </footer>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
