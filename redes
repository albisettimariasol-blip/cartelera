import React, { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, onSnapshot } from 'firebase/firestore';

// --- CONFIGURACIÓN DE FIREBASE ---
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'isfd-19-cartelera';

export default function App() {
  const [user, setUser] = useState(null);
  const [novedades, setNovedades] = useState('Cargando novedades...');
  const [hoja3Data, setHoja3Data] = useState([]);
  const [redesSociales, setRedesSociales] = useState([]);
  const [showQR, setShowQR] = useState(false);

  // Iconos por defecto basados en el nombre de la red
  const getSocialIcon = (nombre) => {
    const n = nombre.toLowerCase();
    if (n.includes('inst')) return <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9zM15 13a3 3 0 11-6 0 3 3 0 016 0z" />;
    if (n.includes('face')) return <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />;
    if (n.includes('web')) return <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />;
    return <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />;
  };

  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInAnonymously(auth);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Error de autenticación:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  useEffect(() => {
    if (!user) return;

    // Escuchar Novedades Principales
    const mainDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'cartelera', 'main');
    const unsubscribeMain = onSnapshot(mainDocRef, (snapshot) => {
      if (snapshot.exists()) {
        const data = snapshot.data();
        setNovedades(data.mensaje || 'Sin novedades.');
      }
    });

    // Escuchar Distribución de Aulas (Hoja 3)
    const hoja3Ref = doc(db, 'artifacts', appId, 'public', 'data', 'cartelera', 'hoja3');
    const unsubscribeHoja3 = onSnapshot(hoja3Ref, (snapshot) => {
      if (snapshot.exists()) {
        const data = snapshot.data();
        setHoja3Data(data.items || []);
      }
    });

    // Escuchar Hoja de Redes (Incluyendo el Centro de Estudiantes)
    const redesRef = doc(db, 'artifacts', appId, 'public', 'data', 'cartelera', 'redes');
    const unsubscribeRedes = onSnapshot(redesRef, (snapshot) => {
      if (snapshot.exists()) {
        const data = snapshot.data();
        setRedesSociales(data.items || []);
      }
    }, (err) => console.error("Error cargando redes:", err));

    return () => {
      unsubscribeMain();
      unsubscribeHoja3();
      unsubscribeRedes();
    };
  }, [user]);

  const shareOnWhatsApp = (item) => {
    const text = `📍 *ISFD 19 - Info Aula*\n\n📚 *Materia:* ${item.titulo}\n🏛️ *Aula:* ${item.detalle}\n🎓 *Carrera:* ${item.categoria}\n\nConsulta la cartelera aquí: ${window.location.href}`;
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
  };

  const copyLink = () => {
    const el = document.createElement('textarea');
    el.value = window.location.href;
    document.body.appendChild(el);
    el.select();
    document.execCommand('copy');
    document.body.removeChild(el);
  };

  // Filtrar el instagram del centro para destacarlo
  const centroRed = redesSociales.find(r => r.titulo.toLowerCase().includes('centro') || r.titulo.toLowerCase().includes('estudiantes'));
  const otrasRedes = redesSociales.filter(r => r !== centroRed);

  return (
    <div className="min-h-screen bg-[#020617] text-slate-100 font-sans selection:bg-blue-500/30">
      {/* Encabezado */}
      <header className="border-b border-slate-800/50 bg-[#020617]/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4">
        <div className="max-w-4xl mx-auto flex justify-between items-center">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-gradient-to-br from-blue-600 to-blue-400 rounded-xl flex items-center justify-center shadow-lg shadow-blue-900/20">
              <span className="font-black italic text-white text-lg">19</span>
            </div>
            <div>
               <h1 className="font-black text-lg uppercase tracking-tighter leading-none">ISFD 19</h1>
               <p className="text-[8px] uppercase tracking-widest text-slate-500 font-bold">Cartelera Digital</p>
            </div>
          </div>
          
          <div className="flex gap-2">
            <button onClick={() => setShowQR(!showQR)} className="p-2 bg-slate-800 rounded-lg hover:bg-slate-700 transition-colors" title="Ver QR">
              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </button>
            <button onClick={copyLink} className="p-2 bg-blue-600 rounded-lg hover:bg-blue-500 transition-colors" title="Copiar Enlace">
              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            </button>
          </div>
        </div>
      </header>

      {/* Modal QR */}
      {showQR && (
        <div className="fixed inset-0 bg-black/90 z-[100] flex items-center justify-center p-6" onClick={() => setShowQR(false)}>
          <div className="bg-white p-8 rounded-[3rem] text-center max-w-xs" onClick={e => e.stopPropagation()}>
            <h3 className="text-black font-black uppercase mb-4 text-sm tracking-widest">Escanear Cartelera</h3>
            <img 
              src={`https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(window.location.href)}&color=1e40af`} 
              alt="Código QR" 
              className="mx-auto mb-4 border-4 border-slate-100 p-2 rounded-2xl"
            />
            <p className="text-slate-500 text-[10px] font-bold uppercase">Acceso directo para estudiantes</p>
          </div>
        </div>
      )}

      <main className="max-w-4xl mx-auto p-6 space-y-10">
        {/* Novedad Principal */}
        <section className="bg-slate-900 border border-slate-800 rounded-[2.5rem] p-8 relative overflow-hidden group">
           <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-100 transition-opacity">
              <svg className="w-24 h-24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5z"/></svg>
           </div>
           <span className="bg-blue-600 text-white text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest mb-4 inline-block shadow-lg shadow-blue-900/40">Comunicado</span>
           <h2 className="text-2xl md:text-3xl font-black italic uppercase leading-tight tracking-tighter">
            {novedades}
          </h2>
        </section>

        {/* Listado de Aulas (Hoja 3) */}
        <section className="space-y-4">
          <div className="flex items-center gap-2 px-2">
            <div className="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
            <h3 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Distribución de Aulas</h3>
          </div>
          
          <div className="grid grid-cols-1 gap-4">
            {hoja3Data.length > 0 ? hoja3Data.map((item, idx) => (
              <div key={idx} className="bg-slate-900/40 border border-slate-800/50 p-6 rounded-3xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 group hover:bg-slate-900 transition-all">
                <div className="flex-1">
                  <p className="text-blue-500 text-[9px] font-black uppercase tracking-widest mb-1">{item.categoria || 'N/A'}</p>
                  <p className="text-lg font-bold italic">{item.titulo || 'Sin título'}</p>
                  <p className="text-slate-400 text-xs mt-1">Ubicación: <span className="text-white font-bold">{item.detalle || '-'}</span></p>
                </div>
                
                <button 
                  onClick={() => shareOnWhatsApp(item)}
                  className="w-full sm:w-auto flex items-center justify-center gap-2 bg-emerald-500/10 text-emerald-400 px-5 py-2.5 rounded-2xl text-[10px] font-black uppercase hover:bg-emerald-500 hover:text-white transition-all border border-emerald-500/20"
                >
                  <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Compartir
                </button>
              </div>
            )) : (
              <div className="text-center py-10 text-slate-600 text-[10px] uppercase font-bold tracking-widest border-2 border-dashed border-slate-800 rounded-3xl">
                Cargando información de aulas...
              </div>
            )}
          </div>
        </section>

        {/* Centro de Estudiantes Destacado */}
        {centroRed && (
          <section className="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-[2.5rem] p-8 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl shadow-blue-500/10">
            <div>
              <p className="text-[10px] font-black uppercase tracking-[0.3em] opacity-80 mb-2">Canal Oficial Estudiantil</p>
              <h3 className="text-2xl font-black italic uppercase leading-none">{centroRed.titulo}</h3>
              <p className="text-sm mt-2 opacity-90 max-w-sm">Enterate de todas las novedades, becas y eventos organizados por tus representantes.</p>
            </div>
            <a 
              href={centroRed.detalle} 
              target="_blank" 
              rel="noopener noreferrer"
              className="bg-white text-blue-600 px-8 py-4 rounded-2xl font-black uppercase text-xs hover:scale-105 transition-transform flex items-center gap-3 shadow-lg"
            >
              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {getSocialIcon('instagram')}
              </svg>
              Seguinos en Instagram
            </a>
          </section>
        )}

        {/* Otras Redes Sociales */}
        <section className="space-y-4">
          <div className="flex items-center gap-2 px-2">
            <h3 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 text-center w-full">Otros Enlaces Útiles</h3>
          </div>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
            {otrasRedes.length > 0 ? (
              otrasRedes.map((red, idx) => (
                <a 
                  key={idx}
                  href={red.detalle} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="bg-slate-900 border border-slate-800 p-6 rounded-3xl flex flex-col items-center gap-3 hover:bg-slate-800 hover:border-blue-500/30 transition-all group"
                >
                  <div className="w-12 h-12 bg-slate-800 group-hover:bg-blue-600/20 rounded-2xl flex items-center justify-center text-slate-400 group-hover:text-blue-400 transition-all shadow-inner">
                    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      {getSocialIcon(red.titulo)}
                    </svg>
                  </div>
                  <span className="text-[9px] font-black uppercase tracking-widest text-slate-300 text-center">{red.titulo}</span>
                </a>
              ))
            ) : null}
          </div>
        </section>
      </main>

      <footer className="max-w-4xl mx-auto p-12 text-center">
        <div className="w-12 h-1 bg-slate-800 mx-auto mb-8 rounded-full"></div>
        <p className="text-[10px] font-black uppercase tracking-[0.5em] text-slate-500 mb-2">ISFD 19 • Mar del Plata</p>
        <p className="text-slate-600 text-[9px] uppercase tracking-widest leading-relaxed max-w-xs mx-auto italic">
          Instituto Superior de Formación Docente Nº19. Información gestionada de forma colaborativa.
        </p>
      </footer>
    </div>
  );
}
